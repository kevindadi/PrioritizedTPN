tools.zip

compile_commands.json
*.json
# Keep the CMake presets (vcpkg/CLion entry point) tracked despite the rule above
!CMakePresets.json
# Keep the project's Zed configuration tracked despite the `*.json` rule above
!.zed/*.json
paper/

**.dot
**.ppn
**.ptpn
**.pdf
**.log

# Golden fixtures are committed despite the generated-artifact patterns above.
!test/golden/**

# Fixture data moved out of example/ is committed despite the generated-artifact patterns above.
!test/fixtures/**
# The old example/ checkout may linger on machines with an inherited delete-deny ACE.
/example/
