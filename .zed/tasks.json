// Project tasks, migrated from `.vscode/tasks.json`.
// Run them via `task: spawn` (cmd-shift-p) or bind `task: rerun` as usual.
[
  {
    "label": "cmake: configure",
    "command": "cmake",
    "args": ["-B", "build", "-G", "Ninja", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
    // NOTE: VS Code pinned g++/gcc on Linux with -DCMAKE_CXX_COMPILER=g++
    // -DCMAKE_C_COMPILER=gcc. Zed tasks have no per-OS variant; add those flags
    // to `args` above if CMake picks a compiler you do not want.
  },
  {
    "label": "cmake: build",
    "command": "cmake",
    "args": ["--build", "build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus",
    "tags": ["cmake-build"]
  },
  {
    "label": "test: all",
    "command": "ctest",
    "args": ["--test-dir", "build", "--output-on-failure"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["cmake-test"]
  }
]
