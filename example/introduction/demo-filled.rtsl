// Runnable version of demo.rtsl with the pending `fusion` timing filled in.
//
// fusion holds one lock, so it declares 2*lock_count+1 = 3 execution segments.
// The values remain an estimate; only `certified by "<tool>"` is a WCET bound.

system demo {
  cpus 3
  cores_per_cpu 1
  time_unit ms
  policy fixed

  task sensor: periodic {
    period 100ms
    deadline 100ms
    core 0
    time [2, 3] estimated by "datasheet"
  }

  task fusion: aperiodic {
    core 1
    locks mutex1
    time [ [1, 1], [1, 2], [1, 1] ] estimated by "llm"
  }

  task logger: aperiodic {
    core 2
    time [1, 2] estimated
  }

  task display: normal {
    core 2
    time [1, 1] estimated
  }

  start sensor
  end display

  sensor -> {fusion, logger}
  {fusion, logger} -> display
}
