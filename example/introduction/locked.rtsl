// One mutex lock: 2*lock_count+1 = 3 execution segments (pre / critical / post).
// Expected: `ptpn rtsl --diagnostics json` exits 0 with no diagnostics.

system locked {
  cpus 1
  cores_per_cpu 1
  time_unit ms
  policy fixed

  task worker: aperiodic {
    core 0
    locks mutex1
    time [ [1, 1], [2, 3], [1, 1] ] estimated by "datasheet"
  }

  start worker
  end worker
}
