// Minimal single-spin-lock model for the spin-lock marking evidence.
//
// The critical section is execution segment 2 (the lock is acquired after
// segment 1 and returned by segment 2), so the lowered PTPN marks segment 2
// non-suspendable and segments 1/3 suspendable. See docs/rtsl.md §7 and the
// reproduction command in §12.2.

system spinlock {
  cpus 1
  cores_per_cpu 1
  time_unit ms
  policy fixed
  task worker: aperiodic {
    core 0
    locks spin1
    time [ [1, 1], [2, 2], [1, 1] ] estimated
  }
  start worker
  end worker
}
