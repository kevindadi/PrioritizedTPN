// A deadline miss that is proven from the explored prefix even when the
// state-class graph is cut by a small `-m` budget: b (2 ms deadline) is
// released at t=0 behind the longer a and cannot finish in time, so R-ANA-002
// fires while E-PERF-001 also reports the truncation.
//
// Commands:
//   ./build/ptpn rtsl -f example/diagnostics/deadline-miss.rtsl --diagnostics json -m 10
//     exit 6; R-ANA-002 (task:b) + E-PERF-001; counterexample "deadline"

system deadline_miss {
  cpus 1
  cores_per_cpu 1
  time_unit ms
  policy fixed

  task a: periodic {
    period 10ms
    deadline 4ms
    core 0
    priority 101
    time [3, 5] estimated
  }

  task b: periodic {
    period 2ms
    deadline 2ms
    core 0
    priority 100
    time [1, 1] estimated
  }

  start a
  start b
}
